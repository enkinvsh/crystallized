{
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "environment": {
        "PATH": "/opt/homebrew/bin:YOUR_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
