{
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "SERENA_PATH",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "environment": {
        "PATH": "YOUR_HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
